<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Xcode 15.3+ spelling; the old value was "app-store". -->
	<key>method</key>
	<string>app-store-connect</string>
	<key>teamID</key>
	<string>XY62X6K9VH</string>
	<key>signingStyle</key>
	<string>automatic</string>
	<!-- Write a local .ipa rather than uploading straight from xcodebuild, so
	     the artifact can be validated before anything is sent to Apple. -->
	<key>destination</key>
	<string>export</string>
	<key>uploadSymbols</key>
	<true/>
	<key>manageAppVersionAndBuildNumber</key>
	<false/>
</dict>
</plist>
